---
interface Props {
    eyebrow: string
    title: string
    description?: string
}
const { eyebrow, title, description } = Astro.props
---

<section class="relative overflow-hidden pb-16 pt-40">
    <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
    <div
        class="absolute left-1/2 top-0 h-[420px] w-[720px] -translate-x-1/2 -translate-y-1/3 rounded-full bg-accent-violet/20 blur-[120px]"
        aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
        <p class="eyebrow fade-in">{eyebrow}</p>
        <h1 class="mt-5 max-w-4xl font-display text-[clamp(2.75rem,8vw,5.5rem)] font-bold leading-[0.95] tracking-tighter">
            {
                title.split(" ").map((word, i) => (
                    <>
                        <span class="split-word">
                            <span style={`--delay: ${100 + i * 80}ms`}>{word}</span>
                        </span>{" "}
                    </>
                ))
            }
        </h1>
        {description && <p class="fade-in mt-6 max-w-xl text-lg text-muted" style="--delay: 500ms">{description}</p>}
        <slot />
    </div>
</section>
