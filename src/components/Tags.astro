---
import { slugify, beautify } from "../ts/utils"

interface Props {
    tags: string[]
    active?: string
}

const { tags, active } = Astro.props
---

<div class="relative z-10 flex flex-wrap gap-2">
    {
        tags.map(tag => {
            const slug = slugify(tag)
            return (
                <a
                    href={`/blog/tags/${slug}`}
                    class:list={[
                        "chip",
                        active === slug && "!border-accent-violet !bg-accent-violet/15 !text-fg",
                    ]}
                >
                    #{beautify(slug)}
                </a>
            )
        })
    }
</div>
