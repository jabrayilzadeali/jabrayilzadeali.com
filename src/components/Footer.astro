---
import { Icon } from "astro-icon/components"
import { navLinks, profile, socials } from "../data/site"

const year = new Date().getFullYear()
---

<footer class="relative z-10 mt-32 border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-10 px-4 py-12 sm:px-6 md:flex-row md:items-end md:justify-between">
        <div>
            <a href="/" class="font-display text-2xl font-semibold tracking-tight">{profile.name}</a>
            <p class="mt-2 max-w-xs text-sm text-muted">{profile.role}. {profile.headline}</p>
            <div class="mt-5 flex items-center gap-2">
                {
                    socials.map(s => (
                        <a
                            href={s.href}
                            target="_blank"
                            rel="noreferrer"
                            class="grid h-10 w-10 place-items-center rounded-full border border-line text-muted transition-all duration-300 hover:-translate-y-1 hover:border-accent-violet hover:text-fg"
                        >
                            <span class="sr-only">{s.name}</span>
                            <Icon name={s.icon} class="h-4 w-4" />
                        </a>
                    ))
                }
            </div>
        </div>

        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:gap-16">
            <ul class="flex gap-6 text-sm text-muted">
                {navLinks.map(l => <li><a href={l.href} class="transition-colors hover:text-fg">{l.label}</a></li>)}
                <li><a href="/rss.xml" class="transition-colors hover:text-fg">RSS</a></li>
            </ul>
            <a
                href="#top"
                class="group inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-muted hover:text-fg"
            >
                Back to top
                <span class="transition-transform duration-300 group-hover:-translate-y-1">↑</span>
            </a>
        </div>
    </div>
    <div class="mx-auto flex max-w-6xl flex-col gap-2 border-t border-line px-4 py-6 text-xs text-muted sm:flex-row sm:justify-between sm:px-6">
        <span>&copy; {year} {profile.name}. All rights reserved.</span>
        <span class="font-mono">Built with Astro · React · Three.js · Tailwind</span>
    </div>
</footer>
