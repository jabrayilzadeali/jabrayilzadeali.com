---
interface Props {
    index: string
    eyebrow: string
    title: string
    class?: string
}
const { index, eyebrow, title, class: className } = Astro.props
---

<div class:list={["max-w-3xl", className]}>
    <p class="eyebrow flex items-center gap-3" data-reveal>
        <span class="text-accent-violet">{index}</span>
        <span class="h-px w-10 bg-line"></span>
        {eyebrow}
    </p>
    <h2 class="section-title mt-5 text-balance" data-reveal style="--delay: 100ms">
        <Fragment set:html={title} />
    </h2>
    <slot />
</div>
