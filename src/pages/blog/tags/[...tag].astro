---
import { getCollection } from "astro:content"
import { Icon } from "astro-icon/components"
import BaseLayout from "../../../layouts/BaseLayout.astro"
import PageHero from "../../../components/PageHero.astro"
import PostCard from "../../../components/PostCard.astro"
import { beautify, slugify } from "../../../ts/utils"

export async function getStaticPaths() {
    const allPosts = (await getCollection("blog")).sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
    )
    const uniqueTags = [...new Set(allPosts.flatMap(post => post.data.tags.map(tag => slugify(tag))))]

    return uniqueTags.map(tag => ({
        params: { tag },
        props: {
            posts: allPosts.filter(post => post.data.tags.map(t => slugify(t)).includes(tag)),
        },
    }))
}

const { tag } = Astro.params
const { posts } = Astro.props
---

<BaseLayout title={`#${beautify(tag)} — Blog`}>
    <main>
        <PageHero
            eyebrow={`Tag · ${posts.length} post${posts.length === 1 ? "" : "s"}`}
            title={`#${beautify(tag)}`}
        >
            <a href="/blog" class="btn-ghost fade-in group mt-8" style="--delay: 400ms">
                <Icon name="arrow-right" class="h-4 w-4 rotate-180 transition-transform duration-300 group-hover:-translate-x-1" />
                All posts
            </a>
        </PageHero>
        <section class="mx-auto max-w-6xl px-4 sm:px-6">
            <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {posts.map((post, i) => <PostCard post={post} delay={(i % 3) * 100} />)}
            </ul>
        </section>
    </main>
</BaseLayout>
