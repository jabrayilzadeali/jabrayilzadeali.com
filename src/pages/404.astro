---
import BaseLayout from "../layouts/BaseLayout.astro"
import { Icon } from "astro-icon/components"
---

<BaseLayout title="404 — Lost in space">
    <main class="relative flex flex-1 items-center justify-center overflow-hidden px-4 py-40">
        <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
        <div class="absolute left-1/2 top-1/2 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent-violet/25 blur-[120px]" aria-hidden="true"></div>
        <div class="relative text-center">
            <p class="eyebrow fade-in">Error 404</p>
            <h1 class="text-gradient fade-in mt-4 font-display text-[clamp(7rem,25vw,16rem)] font-bold leading-none tracking-tighter" style="--delay: 100ms">
                404
            </h1>
            <p class="fade-in mt-4 text-xl text-muted" style="--delay: 250ms">This page drifted off into the void.</p>
            <a href="/" class="btn-primary fade-in group mt-10" style="--delay: 400ms" data-magnetic="0.3">
                <Icon name="arrow-right" class="h-4 w-4 rotate-180 transition-transform duration-300 group-hover:-translate-x-1" />
                Take me home
            </a>
        </div>
    </main>
</BaseLayout>
